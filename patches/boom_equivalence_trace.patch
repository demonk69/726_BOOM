 #include <stdlib.h>
 #include <unistd.h>
 #include <getopt.h>
+#ifdef BOOM_EQUIV_TRACE
+#include <fstream>
+#include <iomanip>
+#define BOOM_CORE_SIG(tile, name) ((tile)->TestHarness__DOT__chiptop__DOT__system__DOT__tile_prci_domain__DOT__tile_reset_domain__DOT__boom_tile__DOT__core__DOT__##name)
+static void boom_equiv_emit_trace(TEST_HARNESS* tile, uint64_t cycle, std::ofstream& out)
+{
+  if (!out.good()) return;
+  if (BOOM_CORE_SIG(tile, rob_io_enq_valids_0)) {
+    out << "{\"cycle\":" << cycle << ",\"event\":\"rob_allocate\",\"slot\":0"
+        << ",\"rob_idx\":" << (uint32_t)BOOM_CORE_SIG(tile, rob_io_enq_uops_0_rob_idx)
+        << ",\"physical_rd\":" << (uint32_t)BOOM_CORE_SIG(tile, rob_io_enq_uops_0_pdst)
+        << ",\"stale_physical_rd\":" << (uint32_t)BOOM_CORE_SIG(tile, rob_io_enq_uops_0_stale_pdst)
+        << "}\n";
+  }
+  if (BOOM_CORE_SIG(tile, csr_exe_unit__DOT__alu_io_req_valid)) {
+    out << "{\"cycle\":" << cycle << ",\"event\":\"iq_select\",\"slot\":0,\"rob_idx\":null}\n";
+    out << "{\"cycle\":" << cycle << ",\"event\":\"execute\",\"slot\":0,\"rob_idx\":null}\n";
+  }
+  if (BOOM_CORE_SIG(tile, csr_exe_unit__DOT__alu_io_resp_valid)) {
+    out << "{\"cycle\":" << cycle << ",\"event\":\"writeback\",\"slot\":0"
+        << ",\"physical_rd\":" << (uint32_t)BOOM_CORE_SIG(tile, csr_exe_unit__DOT__alu__DOT__r_uops_0_pdst)
+        << ",\"rob_idx\":" << (uint32_t)BOOM_CORE_SIG(tile, csr_exe_unit__DOT__alu__DOT__r_uops_0_rob_idx)
+        << "}\n";
+  }
+  if (BOOM_CORE_SIG(tile, rob_io_wb_resps_0_valid)) {
+    out << "{\"cycle\":" << cycle << ",\"event\":\"rob_complete\",\"slot\":0}\n";
+  }
+  if (BOOM_CORE_SIG(tile, brinfos_0_valid)) {
+    out << "{\"cycle\":" << cycle << ",\"event\":\"branch_resolve\",\"slot\":0"
+        << ",\"taken\":" << (BOOM_CORE_SIG(tile, brinfos_0_taken) ? "true" : "false")
+        << ",\"branch_mispredict\":" << (BOOM_CORE_SIG(tile, brinfos_0_mispredict) ? "true" : "false")
+        << ",\"branch_tag\":" << (uint32_t)BOOM_CORE_SIG(tile, brinfos_0_uop_br_tag)
+        << ",\"branch_mask\":" << (uint32_t)BOOM_CORE_SIG(tile, brinfos_0_uop_br_mask)
+        << "}\n";
+  }
+  if (BOOM_CORE_SIG(tile, rob_io_flush_valid)) {
+    out << "{\"cycle\":" << cycle << ",\"event\":\"flush\"}\n";
+  }
+  if (BOOM_CORE_SIG(tile, b2_mispredict)) {
+    out << "{\"cycle\":" << cycle << ",\"event\":\"redirect\",\"target\":\"0x"
+        << std::hex << (uint64_t)BOOM_CORE_SIG(tile, io_ifu_redirect_pc_REG) << std::dec << "\"}\n";
+  }
+  if (BOOM_CORE_SIG(tile, rob_io_commit_arch_valids_0)) {
+    bool rd_valid = BOOM_CORE_SIG(tile, rob_io_commit_uops_0_ldst_val) && BOOM_CORE_SIG(tile, rob_io_commit_uops_0_dst_rtype) == 0;
+    out << "{\"cycle\":" << cycle << ",\"event\":\"commit\",\"slot\":0,\"pc\":\"0x"
+        << std::hex << (uint64_t)BOOM_CORE_SIG(tile, csr_io_pc) << std::dec << "\",\"instruction\":null"
+        << ",\"rd_valid\":" << (rd_valid ? "true" : "false")
+        << ",\"rd\":" << (uint32_t)BOOM_CORE_SIG(tile, rob_io_commit_uops_0_ldst)
+        << ",\"rd_value\":null,\"exception\":false,\"exception_cause\":null,\"privilege\":null}\n";
+  }
+}
+#endif
 
