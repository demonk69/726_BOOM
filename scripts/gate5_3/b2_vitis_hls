#!/usr/bin/env bash
set -euo pipefail

ROOT=${HLS_BOOM_ROOT:-"$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"}
LEGACY="$ROOT/scripts/run_hls_prefix_trace_csim.tcl"
OVERRIDE="$ROOT/scripts/gate5_3/b2_hls_prefix_trace_csim.tcl"
args=("$@")
for index in "${!args[@]}"; do
    [[ "${args[$index]}" != "$LEGACY" ]] || args[$index]="$OVERRIDE"
done
exec /home/lab_726/Xilinx/Vitis_HLS/2021.2/bin/vitis_hls "${args[@]}"
