{
  "format": "jsonl",
  "version": 1,
  "status": "schema_defined_standalone_runner_supported",
  "common_fields": {
    "cycle": "integer, simulated BOOM cycle, monotonically nondecreasing",
    "event": "string",
    "slot": "integer or null",
    "trace_sequence_id": "integer generated by trace adapter only; not fed back into BOOM"
  },
  "events": {
    "commit": {
      "cycle": "integer",
      "event": "commit",
      "slot": "integer",
      "pc": "hex string or null",
      "instruction": "hex string or null if unavailable",
      "rd_valid": "boolean or null",
      "rd": "integer or null",
      "rd_value": "hex string or null if unavailable",
      "exception": "boolean or null",
      "exception_cause": "hex string or null",
      "privilege": "integer or null"
    },
    "rob_allocate": {
      "cycle": "integer",
      "event": "rob_allocate",
      "slot": "integer",
      "rob_idx": "integer or null",
      "physical_rd": "integer or null",
      "stale_physical_rd": "integer or null"
    },
    "iq_insert": { "cycle": "integer", "event": "iq_insert", "slot": "integer", "rob_idx": "integer or null" },
    "iq_select": { "cycle": "integer", "event": "iq_select", "slot": "integer", "rob_idx": "integer or null" },
    "execute": { "cycle": "integer", "event": "execute", "slot": "integer", "rob_idx": "integer or null", "physical_rd": "integer or null", "result": "hex string or null" },
    "writeback": { "cycle": "integer", "event": "writeback", "slot": "integer", "physical_rd": "integer or null", "result": "hex string or null" },
    "rob_complete": { "cycle": "integer", "event": "rob_complete", "slot": "integer", "rob_idx": "integer or null" },
    "branch_resolve": { "cycle": "integer", "event": "branch_resolve", "slot": "integer", "taken": "boolean or null", "branch_mispredict": "boolean or null", "branch_tag": "integer or null", "branch_mask": "integer or null" },
    "redirect": { "cycle": "integer", "event": "redirect", "target": "hex string or null" },
    "flush": { "cycle": "integer", "event": "flush" },
    "exception": { "cycle": "integer", "event": "exception", "exception_cause": "hex string or null" },
    "tohost": { "cycle": "integer", "event": "tohost", "pc": "hex string", "address": "hex string", "value": "hex string", "source": "retired_store or memory_write" },
    "metadata": { "cycle": "integer", "event": "metadata", "phase": "start or end", "termination_reason": "running, tohost, verilator_finish, or max_cycles", "exit_code": "integer", "tohost_value": "hex string or null", "max_cycles_reached": "boolean", "trap_seen": "boolean" }
  },
  "unavailable_fields": {
    "commit.instruction": "available only when reconstructed commit PC maps into the standalone loadmem image; otherwise null",
    "commit.rd_value": "read from exposed physical integer register file when physical destination is in range; not an explicit BOOM commit trace port",
    "rename.physical_rs1": "not exposed as stable trace interface",
    "rename.physical_rs2": "not exposed as stable trace interface",
    "official.noninterference": "blocked until original Chipyard simulator path is restored"
  }
}
