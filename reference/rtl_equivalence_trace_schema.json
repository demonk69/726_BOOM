{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate 3.8 BOOM HLS RTL trace",
  "type": "object",
  "required": ["cycle", "event"],
  "properties": {
    "cycle": {"type": "integer", "minimum": 0},
    "event": {"enum": ["metadata", "reset", "imem_request", "dmem_request", "commit", "tohost"]},
    "pc": {"type": ["string", "null"]},
    "instruction": {"type": ["string", "null"]},
    "rob_idx": {"type": ["integer", "null"]},
    "rd_valid": {"type": "boolean"},
    "rd": {"type": ["integer", "null"]},
    "rd_value": {"type": ["string", "null"]},
    "exception": {"type": "boolean"},
    "exception_cause": {"type": ["string", "null"]},
    "branch_taken": {"type": ["boolean", "null"]},
    "branch_target": {"type": ["string", "null"]},
    "branch_mispredict": {"type": ["boolean", "null"]},
    "redirect": {"type": "boolean"},
    "flush": {"type": "boolean"},
    "memory_valid": {"type": "boolean"},
    "memory_address": {"type": ["string", "null"]},
    "memory_data": {"type": ["string", "null"]},
    "memory_mask": {"type": ["string", "null"]},
    "imem_req_valid": {"type": "boolean"},
    "imem_req_ready": {"type": "boolean"},
    "dmem_req_valid": {"type": "boolean"},
    "dmem_req_ready": {"type": "boolean"},
    "commit_trace_valid": {"type": "boolean"},
    "commit_trace_ready": {"type": "boolean"},
    "reset": {"type": "boolean"}
  },
  "additionalProperties": true
}
